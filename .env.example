# ==========================================
# Hunar Pass - Environment Variables
# ==========================================
# 1. Duplicate this file and rename it to: .env.local
# 2. Fill in your real keys below.
#
# IMPORTANT:
# - Variables starting with NEXT_PUBLIC_ are accessible in the browser.
# - Variables WITHOUT NEXT_PUBLIC_ (like ANTHROPIC_API_KEY) are secret
#   and can ONLY be accessed by server routes (never exposed in the browser).

# ------------------------------------------
# 1. Supabase Credentials
# Find these in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (Optional: Service role key for admin tasks on the server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# 2. Anthropic Claude API Key (Server-side ONLY)
# Find this in: Anthropic Console -> API Keys -> Create Key
# ------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------
# 3. Base Application URL (for QR code links)
# In local development: http://localhost:3000
# In production (e.g. Vercel): https://your-hunar-pass.vercel.app
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
